!version 0.2.0

import engine.ability
import engine.ability.property.type
import engine.ability.type
import engine.util.attribute
import engine.util.game_entity
import engine.util.graphics
import engine.util.hitbox
import engine.util.language.translated.type
import engine.util.selection_box.type
import fvd.data.terrain

Health(engine.util.attribute.Attribute):
    Attribute.name = HealthName
    Attribute.abbreviation = HealthAbbreviation

HealthName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {}

HealthAbbreviation(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {}

Builder(engine.util.game_entity.GameEntity):
    GameEntity.types = {}
    GameEntity.abilities = {Idle, LineOfSight, Live, Move, Turn, Selectable}
    GameEntity.modifiers = {}
    GameEntity.variants = {}

    LineOfSight(engine.ability.type.LineOfSight):
        LineOfSight.range = 6.0

    Idle(engine.ability.type.Idle):
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/orc_idle.sprite"

    Live(engine.ability.type.Live):
        Live.attributes = {HealthSetting}

        HealthSetting(engine.util.attribute.AttributeSetting):
            AttributeSetting.attribute = Health
            AttributeSetting.min_value = 0
            AttributeSetting.max_value = 25
            AttributeSetting.starting_value = 25

    Move(engine.ability.type.Move):
        Move.speed = 3.0
        Move.modes = {}
        Move.path_type = fvd.data.terrain.Land
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/orc_walk.sprite"

    Turn(engine.ability.type.Turn):
        Turn.turn_speed = inf

    Selectable(engine.ability.type.Selectable):
        Selectable.selection_box = Box

        Box(engine.util.selection_box.type.Rectangle):
            Rectangle.width = 0.5
            Rectangle.height = 0.5

Horse(engine.util.game_entity.GameEntity):
    GameEntity.types = {}
    GameEntity.abilities = {Idle, LineOfSight, Live, Move, Attack, Death, Turn, Selectable}
    GameEntity.modifiers = {}
    GameEntity.variants = {}

    LineOfSight(engine.ability.type.LineOfSight):
        LineOfSight.range = 7.0

    Idle(engine.ability.type.Idle):
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Idle1Animation, Idle2Animation}

            Idle1Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/ethereal-hunter-horse/ethereal-hunter-horse-idle1.sprite"

            Idle2Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/ethereal-hunter-horse/ethereal-hunter-horse-idle2.sprite"

    Live(engine.ability.type.Live):
        Live.attributes = {HealthSetting}

        HealthSetting(engine.util.attribute.AttributeSetting):
            AttributeSetting.attribute = Health
            AttributeSetting.min_value = 0
            AttributeSetting.max_value = 90
            AttributeSetting.starting_value = 90

    Move(engine.ability.type.Move):
        Move.speed = 3.0
        Move.modes = {}
        Move.path_type = fvd.data.terrain.Land
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/ethereal-hunter-horse/ethereal-hunter-horse-gallop.sprite"

    Attack(engine.ability.Ability):
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/ethereal-hunter-horse/ethereal-hunter-horse-attack.sprite"

    Death(engine.ability.Ability):
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/ethereal-hunter-horse/ethereal-hunter-horse-death.sprite"

    Turn(engine.ability.type.Turn):
        Turn.turn_speed = inf

    Selectable(engine.ability.type.Selectable):
        Selectable.selection_box = Box

        Box(engine.util.selection_box.type.Rectangle):
            Rectangle.width = 0.8
            Rectangle.height = 0.8

