!version 0.2.0

import engine.root
import engine.util.game_entity
import engine.util.terrain
import fvd.data.entities
import fvd.data.terrain

Civilisation(engine.root.Object):
    name : text
    buildables : set(engine.util.game_entity.GameEntity)

Hunter(Civilisation):
    Civilisation.name = "Hunter"
    Civilisation.buildables = {}

Builders(Civilisation):
    Civilisation.name = "Builders"
    Civilisation.buildables = {fvd.data.entities.MedievalTowerLevel1, fvd.data.entities.EscapeCart}

Scenario(engine.root.Object):
    map_size : int = 128
    chunk_size : int = 16
    player_count : int = 8
    construction_time : float = 0.1
    cart_construction_time : float = 7.5
    tower_demolition_time : int = 30
    horse_spawn_delay : int = 20
    horse_spawn_interval : int = 1
    horse_collision_radius : float = 0.38
    horse_shove_duration : float = 0.3
    tower_arrow_damage : int = 6
    stone_tower_arrow_damage : int = 10
    tower_upgrade_kills : int = 100
    tower_armor : int = 1
    horse_melee_damage : int = 40
    arrow_travel_time : float = 0.2
    hunter_tower_damage : int = 100
    hunter_tower_range : float = 10.0
    hunter_tower_cooldown : float = 1.0
    builder_start_radius : float = 20.0
    hunter : Civilisation = Hunter
    builders : Civilisation = Builders
    builder : engine.util.game_entity.GameEntity = fvd.data.entities.Builder
    horse : engine.util.game_entity.GameEntity = fvd.data.entities.Horse
    escape_cart : engine.util.game_entity.GameEntity = fvd.data.entities.EscapeCart
    foundation : engine.util.game_entity.GameEntity = fvd.data.entities.Foundation
    tower_demolition : engine.util.game_entity.GameEntity = fvd.data.entities.TowerDemolition
    wood_tower : engine.util.game_entity.GameEntity = fvd.data.entities.MedievalTowerLevel1
    stone_tower : engine.util.game_entity.GameEntity = fvd.data.entities.MedievalTowerLevel2
    hunter_tower : engine.util.game_entity.GameEntity = fvd.data.entities.HunterTower
    hunter_rally_point : engine.util.game_entity.GameEntity = fvd.data.entities.HunterRallyPoint
    terrain : engine.util.terrain.Terrain = fvd.data.terrain.Plains
