# NYAN FILE
!version 0.2.0

import engine.util.attribute
import engine.util.language.translated.type

import engine.root as root

Attribute(root.Object):
    name : engine.util.language.translated.type.TranslatedString
    abbreviation : engine.util.language.translated.type.TranslatedString

AttributeAmount(root.Object):
    type : engine.util.attribute.Attribute
    amount : int

AttributeRate(root.Object):
    type : engine.util.attribute.Attribute
    rate : float

AttributeSetting(root.Object):
    attribute : engine.util.attribute.Attribute
    min_value : int
    max_value : int
    starting_value : int

ProtectingAttribute(engine.util.attribute.Attribute):
    protects : engine.util.attribute.Attribute
