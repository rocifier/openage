# NYAN FILE
!version 0.2.0

import engine.util.exchange_mode
import engine.util.price_mode
import engine.util.price_pool

import engine.root as root

ExchangeRate(root.Object):
    base_price : float
    price_adjust : optional(dict(abstract(engine.util.exchange_mode.ExchangeMode), engine.util.price_mode.PriceMode)) = None
    price_pool : optional(children(engine.util.price_pool.PricePool)) = None
