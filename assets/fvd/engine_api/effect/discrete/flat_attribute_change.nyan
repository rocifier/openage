# NYAN FILE
!version 0.2.0

import engine.effect.discrete
import engine.util.attribute
import engine.util.attribute_change_type

FlatAttributeChange(engine.effect.discrete.DiscreteEffect):
    type : children(engine.util.attribute_change_type.AttributeChangeType)
    min_change_value : optional(engine.util.attribute.AttributeAmount) = None
    max_change_value : optional(engine.util.attribute.AttributeAmount) = None
    change_value : engine.util.attribute.AttributeAmount
    ignore_protection : set(engine.util.attribute.ProtectingAttribute)
