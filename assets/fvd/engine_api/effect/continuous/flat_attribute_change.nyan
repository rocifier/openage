# NYAN FILE
!version 0.2.0

import engine.effect.continuous
import engine.util.attribute
import engine.util.attribute_change_type

FlatAttributeChange(engine.effect.continuous.ContinuousEffect):
    type : children(engine.util.attribute_change_type.AttributeChangeType)
    min_change_rate : optional(engine.util.attribute.AttributeRate) = None
    max_change_rate : optional(engine.util.attribute.AttributeRate) = None
    change_rate : engine.util.attribute.AttributeRate
    ignore_protection : set(engine.util.attribute.ProtectingAttribute)
