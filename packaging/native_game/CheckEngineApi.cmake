# Validate the checked-in engine API, including the original SHA3-256 manifest.
# Can be used by CMake configuration, packaging, audit and standalone regression tests.
cmake_policy(PUSH)
if(POLICY CMP0057)
	cmake_policy(SET CMP0057 NEW)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/EngineApiVersion.cmake")

function(fvd_validate_engine_api _api)
	if(NOT IS_DIRECTORY "${_api}")
		message(FATAL_ERROR "Tracked FVD engine API missing at ${_api} (expected ${FVD_ENGINE_API_VERSION})")
	endif()
	foreach(_required modpack.toml manifest.toml root.nyan)
		if(NOT EXISTS "${_api}/${_required}" OR IS_DIRECTORY "${_api}/${_required}")
			message(FATAL_ERROR "Tracked engine API ${FVD_ENGINE_API_VERSION} incomplete: missing ${_required} in ${_api}")
		endif()
	endforeach()
	file(STRINGS "${_api}/modpack.toml" _names REGEX "^[ \t]*name[ \t]*=")
	file(STRINGS "${_api}/modpack.toml" _versions REGEX "^[ \t]*version[ \t]*=")
	list(LENGTH _names _name_count)
	list(LENGTH _versions _version_count)
	if(NOT _name_count EQUAL 1 OR NOT _version_count EQUAL 1)
		message(FATAL_ERROR "Tracked engine API has invalid modpack identity/version metadata at ${_api}")
	endif()
	list(GET _names 0 _name)
	list(GET _versions 0 _version)
	if(NOT _name MATCHES "^[ \t]*name[ \t]*=[ \t]*\"engine\"[ \t]*$")
		message(FATAL_ERROR "Tracked engine API modpack identity is not engine: ${_name}")
	endif()
	if(NOT _version MATCHES "^[ \t]*version[ \t]*=[ \t]*\"([^\"]+)\"")
		message(FATAL_ERROR "Tracked engine API has invalid version: ${_version}")
	endif()
	set(_actual_version "${CMAKE_MATCH_1}")
	if(NOT _actual_version STREQUAL FVD_ENGINE_API_VERSION)
		message(FATAL_ERROR "Incompatible tracked engine API: expected ${FVD_ENGINE_API_VERSION}, found ${_actual_version} at ${_api}")
	endif()

	file(GLOB_RECURSE _nyan_files LIST_DIRECTORIES FALSE "${_api}/*.nyan")
	list(LENGTH _nyan_files _nyan_count)
	if(NOT _nyan_count EQUAL FVD_ENGINE_API_NYAN_FILES)
		message(FATAL_ERROR "Incomplete tracked engine API ${_actual_version}: expected ${FVD_ENGINE_API_NYAN_FILES} nyan files, found ${_nyan_count} at ${_api}")
	endif()
	file(STRINGS "${_api}/manifest.toml" _hash_algorithm REGEX "^[ \t]*hash[ \t]*=")
	if(NOT "${_hash_algorithm}" MATCHES "hash[ \t]*=[ \t]*\"sha3_256\"")
		message(FATAL_ERROR "Tracked engine API manifest must use SHA3-256: ${_api}/manifest.toml")
	endif()
	file(STRINGS "${_api}/manifest.toml" _entries REGEX "^[0-9a-fA-F]+[ \t]*=")
	list(LENGTH _entries _entry_count)
	math(EXPR _expected_entries "${FVD_ENGINE_API_NYAN_FILES} + 1")
	if(NOT _entry_count EQUAL _expected_entries)
		message(FATAL_ERROR "Incomplete tracked engine API manifest: expected ${_expected_entries} hashes, found ${_entry_count}")
	endif()
	set(_paths "")
	foreach(_entry IN LISTS _entries)
		if(NOT _entry MATCHES "^([0-9a-fA-F]+)[ \t]*=[ \t]*\"([^\"]+)\"[ \t]*$")
			message(FATAL_ERROR "Invalid tracked engine API manifest entry: ${_entry}")
		endif()
		set(_hash "${CMAKE_MATCH_1}")
		set(_path "${CMAKE_MATCH_2}")
		string(LENGTH "${_hash}" _hash_length)
		if(NOT _hash_length EQUAL 64 OR _path MATCHES "(^/|\\\\|(^|/)\\.\\.(/|$))"
		   OR NOT (_path STREQUAL "modpack.toml" OR _path MATCHES "^[a-zA-Z0-9_./-]+[.]nyan$"))
			message(FATAL_ERROR "Unsafe tracked engine API manifest entry: ${_path}")
		endif()
		if(_path IN_LIST _paths)
			message(FATAL_ERROR "Duplicate tracked engine API manifest path: ${_path}")
		endif()
		list(APPEND _paths "${_path}")
		if(NOT EXISTS "${_api}/${_path}" OR IS_DIRECTORY "${_api}/${_path}")
			message(FATAL_ERROR "Incomplete tracked engine API: missing hashed file ${_path}")
		endif()
		file(SHA3_256 "${_api}/${_path}" _actual_hash)
		if(NOT _actual_hash STREQUAL _hash)
			message(FATAL_ERROR "Tracked engine API checksum mismatch: ${_path}")
		endif()
	endforeach()
	if(NOT "modpack.toml" IN_LIST _paths)
		message(FATAL_ERROR "Tracked engine API manifest omits modpack.toml")
	endif()
	foreach(_file IN LISTS _nyan_files)
		file(RELATIVE_PATH _relative "${_api}" "${_file}")
		string(REPLACE "\\" "/" _relative "${_relative}")
		if(NOT _relative IN_LIST _paths)
			message(FATAL_ERROR "Tracked engine API manifest omits ${_relative}")
		endif()
	endforeach()
endfunction()

if(DEFINED FVD_ENGINE_API_ROOT)
	fvd_validate_engine_api("${FVD_ENGINE_API_ROOT}")
endif()

cmake_policy(POP)
