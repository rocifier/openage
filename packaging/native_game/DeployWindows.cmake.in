# Copyright 2026 the openage authors. See copying.md for legal info.
# FVDNative install component only: packaging-time tools, not runtime.
# Qt plugins are deployed by native tools or PowerShell; no Python.

set(_bin "${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
set(_assets "${CMAKE_INSTALL_PREFIX}/@ASSET_DIR@")
set(_vcpkg "@vcpkg_dir@")
set(_windeployqt "@windeployqt@")
set(_game "${_bin}/openage-native.exe")
set(_relay "${_bin}/openage-relay.exe")

if(NOT EXISTS "${_game}" OR NOT EXISTS "${_relay}")
	message(FATAL_ERROR "FVDNative game/relay executables are missing from ${_bin}")
endif()

# Qt binaries/QML modules: use windeployqt when available, otherwise scan QML
# imports and copy modules/plugins with the built-in PowerShell JSON parser.
find_program(_powershell NAMES powershell.exe)
if(NOT _powershell)
	message(FATAL_ERROR "PowerShell is required for native Windows Qt deployment and audit")
endif()
if(EXISTS "${_windeployqt}")
	execute_process(
		COMMAND "${CMAKE_COMMAND}" -E env "PATH=${_vcpkg}/bin;$ENV{PATH}"
			"${_windeployqt}"
			--qmldir "${_assets}"
			--dir "${_bin}"
			--plugindir "${_bin}/plugins"
			--libdir "${_bin}"
			"${_game}"
		RESULT_VARIABLE _deploy_rc)
	if(NOT _deploy_rc EQUAL 0)
		message(FATAL_ERROR "windeployqt failed to deploy FVD Qt runtime (${_deploy_rc})")
	endif()
else()
	set(_qmlscanner "${_vcpkg}/tools/Qt6/bin/qmlimportscanner.exe")
	if(NOT EXISTS "${_qmlscanner}")
		message(FATAL_ERROR "FVDNative needs windeployqt or vcpkg qmlimportscanner.exe")
	endif()
	execute_process(
		COMMAND "${_powershell}" -NoProfile -ExecutionPolicy Bypass
			-File "@CMAKE_SOURCE_DIR@/packaging/native_game/DeployQtWindows.ps1"
			-Scanner "${_qmlscanner}"
			-QmlRoot "${_assets}"
			-QtRoot "${_vcpkg}/Qt6"
			-Destination "${_bin}"
		RESULT_VARIABLE _deploy_rc)
	if(NOT _deploy_rc EQUAL 0)
		message(FATAL_ERROR "Native PowerShell Qt deployment failed (${_deploy_rc})")
	endif()
endif()

# Native openage is directly inside bin/, not in python/.
file(WRITE "${_bin}/qt.conf" "[Paths]\nPlugins = plugins\nQml2Imports = qml\n")

# Resolve vcpkg DLL imports recursively, including the Qt plugins.
get_filename_component(_linker_dir "@CMAKE_LINKER@" DIRECTORY)
find_program(_dumpbin dumpbin.exe HINTS "${_linker_dir}")
if(NOT _dumpbin)
	message(FATAL_ERROR "dumpbin.exe was not found; cannot audit FVDNative dependencies")
endif()

function(_copy_imports _binary)
	execute_process(COMMAND "${_dumpbin}" /DEPENDENTS "${_binary}"
		OUTPUT_VARIABLE _text RESULT_VARIABLE _rc)
	if(NOT _rc EQUAL 0)
		message(FATAL_ERROR "dumpbin failed for ${_binary}")
	endif()
	string(REGEX MATCHALL "[^\r\n]*[.][dD][lL][lL]" _rows "${_text}")
	foreach(_row IN LISTS _rows)
		string(STRIP "${_row}" _name)
		if(NOT _name MATCHES "^[A-Za-z0-9_.+-]+[.][dD][lL][lL]$")
			continue()
		endif()
		if(_name MATCHES "^[Pp][Yy][Tt][Hh][Oo][Nn][0-9]*([_]d)?[.]")
			message(FATAL_ERROR "Python ABI import in FVDNative: ${_binary} -> ${_name}")
		endif()
		if(EXISTS "${_bin}/${_name}")
			continue()
		endif()
		if(EXISTS "${_vcpkg}/bin/${_name}")
			file(COPY "${_vcpkg}/bin/${_name}" DESTINATION "${_bin}")
			_copy_imports("${_bin}/${_name}")
		endif()
	endforeach()
endfunction()

file(GLOB_RECURSE _native_binaries "${_bin}/*.dll" "${_bin}/*.exe")
foreach(_native IN LISTS _native_binaries)
	_copy_imports("${_native}")
endforeach()

# Fontconfig configuration is relative to native executable, not python.exe.
if(EXISTS "${_vcpkg}/etc/fonts")
	file(COPY "${_vcpkg}/etc/fonts" DESTINATION "${_bin}")
elseif(EXISTS "${_vcpkg}/tools/fontconfig/fonts")
	file(COPY "${_vcpkg}/tools/fontconfig/fonts" DESTINATION "${_bin}")
endif()

# Package creation is a release gate: validate the complete staged archive,
# then check every EXE/DLL (including recursively deployed Qt plugins).
execute_process(
	COMMAND "${CMAKE_COMMAND}"
		"-DFVD_NATIVE_STAGE=${CMAKE_INSTALL_PREFIX}"
		"-DFVD_NATIVE_REQUIRE_MANIFEST=ON"
		-P "@CMAKE_SOURCE_DIR@/packaging/native_game/AuditNativePackage.cmake"
	RESULT_VARIABLE _audit_rc)
if(NOT _audit_rc EQUAL 0)
	message(FATAL_ERROR "Native Windows package audit failed (${_audit_rc})")
endif()
execute_process(
	COMMAND "${_powershell}" -NoProfile -ExecutionPolicy Bypass
		-File "@CMAKE_SOURCE_DIR@/packaging/native_game/AuditWindowsImports.ps1"
		-Stage "${CMAKE_INSTALL_PREFIX}"
		-Dumpbin "${_dumpbin}"
	RESULT_VARIABLE _imports_rc)
if(NOT _imports_rc EQUAL 0)
	message(FATAL_ERROR "Windows import audit failed (${_imports_rc})")
endif()

# Ensure the real staged executable accepts every manifest entry before
# CPack emits a release archive. This catches missing/misfiltered assets
# (including nested documentation excluded by install rules) on the builder.
execute_process(
	COMMAND "${_game}" --verify-assets
	WORKING_DIRECTORY "${_bin}"
	OUTPUT_VARIABLE _verify_output
	ERROR_VARIABLE _verify_error
	RESULT_VARIABLE _verify_rc)
if(NOT _verify_rc EQUAL 0)
	message(FATAL_ERROR
		"FVDNative staged asset verification failed (${_verify_rc}): "
		"${_verify_output}\n${_verify_error}")
endif()
message(STATUS "${_verify_output}")
message(STATUS "FVDNative Windows runtime staged, integrity-verified and audited without Python")

