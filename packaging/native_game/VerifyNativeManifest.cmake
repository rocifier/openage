# Verify every installed native FVD SHA-256 input; no Python or game binary needed.
if(NOT DEFINED FVD_NATIVE_STAGE OR NOT IS_DIRECTORY "${FVD_NATIVE_STAGE}")
	message(FATAL_ERROR "Specify -DFVD_NATIVE_STAGE=<existing stage>")
endif()
set(_root "${FVD_NATIVE_STAGE}/share/openage")
set(_manifest "${_root}/fvd-native-manifest.toml")
if(NOT EXISTS "${_manifest}")
	message(FATAL_ERROR "Native FVD stage is missing its integrity manifest: ${_manifest}")
endif()
file(STRINGS "${_manifest}" _path_rows REGEX "^path = ")
file(STRINGS "${_manifest}" _hash_rows REGEX "^sha256 = ")
file(STRINGS "${_manifest}" _record_rows REGEX "^\\[\\[file\\]\\]$")
list(LENGTH _path_rows _paths_count)
list(LENGTH _hash_rows _hashes_count)
list(LENGTH _record_rows _records_count)
if(_paths_count LESS 4 OR NOT _paths_count EQUAL _hashes_count
	OR NOT _paths_count EQUAL _records_count)
	message(FATAL_ERROR "Malformed FVD native manifest: paths=${_paths_count} hashes=${_hashes_count} records=${_records_count}")
endif()
math(EXPR _last "${_paths_count} - 1")
set(_seen)
foreach(_index RANGE 0 ${_last})
	list(GET _path_rows ${_index} _path_row)
	list(GET _hash_rows ${_index} _hash_row)
	if(NOT _path_row MATCHES "^path = \"([^\"]+)\"$")
		message(FATAL_ERROR "Invalid native asset path record: ${_path_row}")
	endif()
	set(_path "${CMAKE_MATCH_1}")
	if(_path MATCHES "^/" OR _path MATCHES "(^|/)\\.\\.(/|$)" OR
		_path MATCHES "\\\\" OR _path MATCHES "^[A-Za-z]:")
		message(FATAL_ERROR "Unsafe native asset path: ${_path}")
	endif()
	list(FIND _seen "${_path}" _duplicate)
	if(NOT _duplicate EQUAL -1)
		message(FATAL_ERROR "Duplicate native asset: ${_path}")
	endif()
	list(APPEND _seen "${_path}")
	if(NOT _hash_row MATCHES "^sha256 = \"([0-9a-fA-F]+)\"$")
		message(FATAL_ERROR "Invalid SHA-256 record: ${_hash_row}")
	endif()
	set(_expected "${CMAKE_MATCH_1}")
	string(LENGTH "${_expected}" _hash_size)
	if(NOT _hash_size EQUAL 64)
		message(FATAL_ERROR "Invalid SHA-256 length for ${_path}")
	endif()
	set(_asset "${_root}/${_path}")
	if(NOT EXISTS "${_asset}" OR IS_DIRECTORY "${_asset}")
		message(FATAL_ERROR "Native FVD manifest references missing asset: ${_path}")
	endif()
	file(SHA256 "${_asset}" _actual)
	if(NOT _actual STREQUAL _expected)
		message(FATAL_ERROR "Native FVD asset checksum mismatch: ${_path}")
	endif()
endforeach()
message(STATUS "FVD native manifest verified: ${_paths_count} SHA-256 inputs")
