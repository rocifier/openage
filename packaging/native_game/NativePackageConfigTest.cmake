# CTest: only one auditable native component and one archive generator.
if(NOT DEFINED FVD_CPACK_CONFIG OR NOT EXISTS "${FVD_CPACK_CONFIG}")
	message(FATAL_ERROR "CPackConfig.cmake was not generated")
endif()
include("${FVD_CPACK_CONFIG}")
if(NOT CPACK_GENERATOR STREQUAL "7Z")
	message(FATAL_ERROR "Only 7Z is supported: ${CPACK_GENERATOR}")
endif()
if(NOT CPACK_COMPONENTS_ALL STREQUAL "FVDNative")
	message(FATAL_ERROR "Expected FVDNative component, got ${CPACK_COMPONENTS_ALL}")
endif()
if(NOT CPACK_ARCHIVE_COMPONENT_INSTALL)
	message(FATAL_ERROR "Component staging must be enabled")
endif()
if(NOT CPACK_COMPONENTS_GROUPING STREQUAL "ALL_COMPONENTS_IN_ONE")
	message(FATAL_ERROR "Expected one native payload")
endif()
# Verify portable filename compatibility and reject retired NSIS explicitly.
include("${CMAKE_CURRENT_LIST_DIR}/../CPackOptions.cmake")
if(CPACK_SYSTEM_NAME STREQUAL "Linux")
	if(NOT CPACK_PACKAGE_FILE_NAME STREQUAL "fvd")
		message(FATAL_ERROR "Linux archive filename changed: ${CPACK_PACKAGE_FILE_NAME}")
	endif()
elseif(NOT CPACK_PACKAGE_FILE_NAME MATCHES "-portable")
	message(FATAL_ERROR "Portable archive suffix changed: ${CPACK_PACKAGE_FILE_NAME}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCPACK_GENERATOR=NSIS"
	-P "${CMAKE_CURRENT_LIST_DIR}/../CPackOptions.cmake"
	RESULT_VARIABLE _nsis_rc OUTPUT_QUIET ERROR_QUIET)
if(_nsis_rc EQUAL 0)
	message(FATAL_ERROR "Retired NSIS generator was unexpectedly accepted")
endif()
message(STATUS "PASS: FVDNative-only 7Z; portable names retained; NSIS rejected")
