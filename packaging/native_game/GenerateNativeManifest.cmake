#
# Developer/release build-time tool. Never run by the player.
# Invoked with -DFVD_MANIFEST_SOURCE_ASSETS, -DFVD_MANIFEST_API_ASSETS
# and -DFVD_MANIFEST_OUTPUT. Generated relative paths match installed assets.

foreach(_var FVD_MANIFEST_SOURCE_ASSETS FVD_MANIFEST_API_ASSETS FVD_MANIFEST_OUTPUT)
	if(NOT DEFINED ${_var} OR "${${_var}}" STREQUAL "")
		message(FATAL_ERROR "Missing required ${_var}")
	endif()
endforeach()

set(_root "${FVD_MANIFEST_SOURCE_ASSETS}")
set(_engine "${FVD_MANIFEST_API_ASSETS}")
foreach(_file
	"${_root}/fvd/modpack.toml"
	"${_engine}/modpack.toml"
	"${_engine}/manifest.toml")
	if(NOT EXISTS "${_file}")
		message(FATAL_ERROR "Missing native FVD release asset: ${_file}")
	endif()
endforeach()

# Do not accidentally package a stale exported API from an older engine.
file(STRINGS "${_engine}/modpack.toml" _version_lines
	REGEX "^version[ \t]*=[ \t]*[\"]0[.]5[.]0[\"]")
if(NOT _version_lines)
	message(FATAL_ERROR "Exported nyan API must have version 0.5.0")
endif()

set(_content "# Generated by GenerateNativeManifest.cmake; do not edit.\n[fvd_native]\nformat = 1\napi_version = \"0.5.0\"\n\n")
set(_count 0)
function(_append_file _path _source)
	file(SHA256 "${_source}" _digest)
	string(APPEND _content "[[file]]\npath = \"${_path}\"\nsha256 = \"${_digest}\"\n\n")
	math(EXPR _count "${_count} + 1")
	set(_count "${_count}" PARENT_SCOPE)
	set(_content "${_content}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE _asset_files LIST_DIRECTORIES FALSE
	RELATIVE "${_root}"
	"${_root}/fvd/*"
	"${_root}/shaders/*"
	"${_root}/qml/*"
	"${_root}/test/textures/*")
list(SORT _asset_files)
foreach(_path IN LISTS _asset_files)
	# Keep in sync with NativePackage.cmake's asset installation filters.
	if(_path MATCHES "(^|/)CMakeLists[.]txt$"
	   OR _path MATCHES "^fvd/(.*/)?(README[.]md|prompts[.]md)$"
	   OR (_path MATCHES "^shaders/" AND NOT _path MATCHES "[.]glsl$")
	   OR (_path MATCHES "^qml/" AND NOT _path MATCHES "[.]qml$"))
		continue()
	endif()
	_append_file("${_path}" "${_root}/${_path}")
endforeach()

file(GLOB_RECURSE _api_files LIST_DIRECTORIES FALSE RELATIVE "${_engine}" "${_engine}/*")
list(SORT _api_files)
foreach(_path IN LISTS _api_files)
	_append_file("converted/engine/${_path}" "${_engine}/${_path}")
endforeach()

if(_count LESS 4)
	message(FATAL_ERROR "FVD release manifest has too few files")
endif()

get_filename_component(_output_dir "${FVD_MANIFEST_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_output_dir}")
file(WRITE "${FVD_MANIFEST_OUTPUT}" "${_content}")
message(STATUS "FVD native release manifest: ${_count} hashed files")
