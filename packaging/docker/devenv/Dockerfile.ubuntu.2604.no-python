# Native-only Linux acceptance environment. The final image contains no Python.
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake curl flex g++ gcc git make ninja-build \
    pkg-config libeigen3-dev libepoxy-dev libfontconfig1-dev \
    libfreetype-dev libharfbuzz-dev libogg-dev libopus-dev \
    libopusfile-dev libpng-dev libtoml11-dev \
    qt6-declarative-dev qt6-multimedia-dev qt6-shadertools-dev qml6-module-qtquick-controls \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu's Qt development packages pull in Python for optional tooling even
# though the native FVD build does not use it. Remove that transitive runtime
# while retaining the native package payload, then let the build prove none of
# those tools need the interpreter.
RUN set -eux; \
    python_packages="$(dpkg-query -W -f='${binary:Package}\n' \
        'python3*' 'libpython3*' 2>/dev/null || true)"; \
    if [ -n "$python_packages" ]; then \
        dpkg --purge --force-depends $python_packages; \
    fi; \
    ! command -v python3; \
    ! find /usr/lib /usr/local/lib -type f -name 'libpython3*.so*' -print -quit | grep -q .
# No Python/Cython/Mako/NumPy development or runtime packages remain here.
