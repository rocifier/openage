# Native-only Linux acceptance environment. Intentionally NEVER install Python.
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake curl flex g++ gcc git make ninja-build \
    pkg-config libeigen3-dev libepoxy-dev libfontconfig1-dev \
    libfreetype-dev libharfbuzz-dev libogg-dev libopus-dev \
    libopusfile-dev libpng-dev libtoml11-dev \
    qt6-declarative-dev qt6-multimedia-dev qml6-module-qtquick-controls \
    && rm -rf /var/lib/apt/lists/*
# No Python/Cython/Mako/NumPy development or runtime packages here.
