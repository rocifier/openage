{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure & Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure",
                "Build"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Configure",
            "type": "shell",
            "command": "${workspaceFolder}/configure",
            "args": [
                // "--optimize", "0", // Comment this out to disable compiler optimization for debug runs
                // "--ccache",        // Comment this out if you want to use ccache
                // "--download-nyan"  // Comment this out if you do not want to clone and build nyan yourself
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "make",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Sanity Check",
            "type": "shell",
            "command": "make",
            "args": [
                "checkmerge"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "FVD Native C++ Tests",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "test"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "test"]
            },
            "group": {"kind": "test", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "new"}
        },
        {
            "label": "FVD Pure Python Tests",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "python-test"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "python-test"]
            },
            "group": "test",
            "presentation": {"reveal": "always", "panel": "new"}
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "cleanbuilddirs"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
