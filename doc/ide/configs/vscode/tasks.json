{
    // Native-only FVD tasks. The deleted ./configure and Python launcher are
    // intentionally not referenced. Launch tasks build the latest local binary.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FVD: Build",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "build"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "build"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "FVD: Native C++ Tests",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "test"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "test"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "test", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "FVD: Package Release Archive",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "package"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "package"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "FVD: Open Multiplayer Lobby",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "game"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "game"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "FVD: Launch Solo",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "solo"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "solo"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "FVD: Start Relay",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "relay"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "relay"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "FVD: Optional Python Unit Tests",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/build-fvd.sh", "python-test"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-fvd.ps1", "python-test"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": []
        }
    ]
}
